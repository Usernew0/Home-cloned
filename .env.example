# Public project URL. Read by server at runtime and browser build at build time.
# Preferred over the legacy VITE_SUPABASE_URL alias when both exist.
SUPABASE_URL=

# PUBLIC Supabase anon key, included in browser code. NEVER use a service-role key here.
VITE_SUPABASE_ANON_KEY=

# Server-only secrets. Never add VITE_ to these names.
SUPABASE_SERVICE_ROLE_KEY=
SERVER_SESSION_SECRET=

# Required for Firestore custom-token sign-in, using the same project as firebase-applet-config.json.
FIREBASE_SERVICE_ACCOUNT_EMAIL=
# PEM value: actual newlines or escaped \n are supported.
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Optional server-only feature configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=

# Optional PUBLIC display/reserved-name fallback, not authentication.
VITE_APP_USERNAME=

# Do not configure VITE_*PASSWORD* or VITE_SUPABASE_SERVICE_ROLE_KEY.
# Builds refuse these legacy secret variables rather than expose or silently ignore them.
# UI card/milestone passcodes need a separate reviewed server-side design.
# Leave ENABLE_PASSWORD_REHASH and FIREBASE_ALLOW_DEFAULT_TENANT unset unless separately reviewed.
