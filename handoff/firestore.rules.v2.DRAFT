rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net catch-all: default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Common sanitization and validation helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation functions
    function isValidMilestone(data) {
      return data.keys().hasAll(['id', 'category', 'title', 'date', 'description', 'sweetMessage', 'photos', 'themeColor'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.category is string && data.category.size() <= 64
        && data.title is string && data.title.size() <= 200
        && data.date is string && data.date.size() <= 32
        && data.description is string && data.description.size() <= 2000
        && data.sweetMessage is string && data.sweetMessage.size() <= 2000
        && data.photos is list && data.photos.size() <= 50
        && data.themeColor is string && data.themeColor.size() <= 100
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidDatePlan(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'dateTime', 'location', 'description', 'checklist', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 64
        && data.dateTime is string && data.dateTime.size() <= 64
        && data.location is string && data.location.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.checklist is list && data.checklist.size() <= 100
        && data.status is string && data.status.size() <= 32
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidMemory(data) {
      return data.keys().hasAll(['id', 'title', 'type', 'url', 'description', 'date', 'category'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.type is string && (data.type == 'image' || data.type == 'video')
        && data.url is string && data.url.size() <= 5000000
        && data.description is string && data.description.size() <= 1000
        && data.date is string && data.date.size() <= 32
        && data.category is string && data.category.size() <= 64
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidLoveLetter(data) {
      return data.keys().hasAll(['id', 'sender', 'recipient', 'subject', 'content', 'template', 'isOpened', 'date'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.sender is string && data.sender.size() <= 100
        && data.recipient is string && data.recipient.size() <= 100
        && data.subject is string && data.subject.size() <= 200
        && data.content is string && data.content.size() <= 10000
        && data.template is string && data.template.size() <= 32
        && data.isOpened is bool
        && data.date is string && data.date.size() <= 32
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'sender', 'content', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.sender is string && data.sender.size() <= 100
        && data.content is string && data.content.size() <= 10000
        && data.timestamp is string && data.timestamp.size() <= 64
        && (!('audioUrl' in data) || (data.audioUrl is string && data.audioUrl.size() <= 5000000))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 5000000))
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidPresence(data) {
      return data.keys().hasAll(['username', 'lastActive'])
        && data.username is string && data.username.size() > 0 && data.username.size() <= 100
        && data.lastActive is string && data.lastActive.size() <= 64
        && (!('isOnline' in data) || data.isOnline is bool)
        && (!('lastReadChatTime' in data) || data.lastReadChatTime == null || data.lastReadChatTime is number)
        && (!('typingIn' in data) || data.typingIn == null || (data.typingIn is string && data.typingIn.size() <= 128))
        && (!('typingAt' in data) || data.typingAt == null || (data.typingAt is string && data.typingAt.size() <= 64));
    }

    function isValidTypingStatus(data) {
      return data.keys().hasAll(['username', 'isTyping'])
        && data.username is string && data.username.size() > 0 && data.username.size() <= 100
        && data.isTyping is bool
        && (!('timestamp' in data) || data.timestamp is number || (data.timestamp is string && data.timestamp.size() <= 64));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'type', 'sender'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.type is string && data.type.size() <= 64
        && data.sender is string && data.sender.size() <= 100
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64))
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128));
    }

    function isValidChatGroup(data) {
      return data.keys().hasAll(['id', 'name', 'createdBy', 'members'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.createdBy is string && data.createdBy.size() <= 100
        && data.members is list && data.members.size() <= 500;
    }

    function isValidCoupleQuestion(data) {
      return data.keys().hasAll(['id', 'text', 'category', 'createdAt', 'answers'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.text is string && data.text.size() <= 1000
        && data.category is string && data.category.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.answers is list && data.answers.size() <= 100
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'username', 'password'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 128
        && data.password is string && data.password.size() >= 4 && data.password.size() <= 256
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('role' in data) || (data.role is string && data.role.size() <= 32));
    }

    function isValidAdminSetting(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128;
    }

    function isValidCoupleTenant(data) {
      return data.coupleId is string && data.coupleId.size() > 0 && data.coupleId.size() <= 128
        && (!('partner1' in data) || (data.partner1 is string && data.partner1.size() <= 100))
        && (!('partner2' in data) || (data.partner2 is string && data.partner2.size() <= 100))
        && (!('plan' in data) || (data.plan is string && data.plan.size() <= 64));
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['id', 'username', 'action', 'details', 'timestamp'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.username is string && data.username.size() <= 100
        && data.action is string && data.action.size() <= 100
        && data.details is string && data.details.size() <= 1000
        && data.timestamp is string && data.timestamp.size() <= 64
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidCelebrationCard(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'targetDate'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.type is string && data.type.size() <= 64
        && data.title is string && data.title.size() <= 200
        && data.targetDate is string && data.targetDate.size() <= 64
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidMusicTrack(data) {
      return data.keys().hasAll(['id', 'title', 'url', 'createdAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.url is string && data.url.size() <= 10000000
        && data.createdAt is string && data.createdAt.size() <= 64
        && (!('artist' in data) || (data.artist is string && data.artist.size() <= 200))
        && (!('duration' in data) || (data.duration is string && data.duration.size() <= 32))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('dedication' in data) || (data.dedication is string && data.dedication.size() <= 2000))
        && (!('userId' in data) || (data.userId is string && data.userId.size() <= 128))
        && (!('uploadedBy' in data) || (data.uploadedBy is string && data.uploadedBy.size() <= 128))
        && (!('fileName' in data) || (data.fileName is string && data.fileName.size() <= 256))
        && (!('fileSize' in data) || (data.fileSize is string && data.fileSize.size() <= 64))
        && (!('isPreset' in data) || (data.isPreset is bool))
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    // ==========================================
    // HARDENED COLLECTION ACCESS RULES
    // ==========================================

    // ---- Identity and tenancy come from the server-minted Firebase custom token (claims: coupleId, role, username).
    function signedIn() { return request.auth != null && request.auth.token.keys().hasAll(['coupleId', 'role', 'username']); }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function canWrite() { return signedIn() && request.auth.token.role in ['admin', 'partner', 'user']; }
    function me() { return request.auth.token.username; }
    // Permanent participant id minted by the server at login (never a username). Empty on tokens minted before it existed.
    // Per-account lounge switch carried in the signed token (default open). Closing the lounge denies both read and send.
    function globalOpen() { return request.auth.token.get('globalChat', false) == true; }
    function pid() { return request.auth.token.get('pid', ''); }
    function sameCouple(data) { return signedIn() && data.get('coupleId', null) == request.auth.token.coupleId; }
    // ---- v2 membership (DRAFT, publish only together with the v2 server release and after members/{pid} docs exist).
    // personalCoupleId is immutable once set (database trigger), so a token claim is safe for the owner's own space.
    // The CURRENT joint space is checked live against members/{pid} (written only by the server saga), never against the token claim.
    function personalId() { return request.auth.token.get('personalCoupleId', ''); }
    function ownPersonal(data) { return signedIn() && personalId() != '' && data.get('coupleId', null) == personalId(); }
    function memberPath() { return /databases/$(database)/documents/members/$(pid()); }
    function jointRead(data) {
      return signedIn() && pid() != '' && exists(memberPath())
        && get(memberPath()).data.state == 'active'
        && get(memberPath()).data.coupleId is string && get(memberPath()).data.coupleId.size() > 0
        && data.get('coupleId', null) == get(memberPath()).data.coupleId;
    }

    match /presence/{username} {
      // Couple-scoped presence: partners see each other, nobody else does.
      allow read: if isAdmin() || (signedIn() && sameCouple(resource.data));
      allow create, update: if canWrite() && isValidId(username) && username.lower() == me().lower()
        && incoming().username.lower() == me().lower() && sameCouple(incoming()) && isValidPresence(incoming());
      allow delete: if canWrite() && username.lower() == me().lower();
    }

    // No client code reads or writes these (verified by search); closed.
    match /typingStatus/{username} { allow read, write: if false; }
    match /notifications/{notificationId} { allow read, write: if false; }

    // Groups: visible and editable by members (and pending invitees) only. App admins get no read or edit access to a group (they may delete
    // one for moderation). Group-admin powers are enforced here, not only in the client. Membership is still matched on usernames.
    function isGroupAdmin(g) { return me() == g.createdBy || me() in g.get('admins', []); }
    function isGroupMember(g) { return me() in g.members; }
    function isGroupInvitee(g) { return me() in g.get('pendingMembers', []); }
    // Creator-only soft delete: empties membership and marks the doc; the id then stays reserved forever.
    function groupTombstone(groupId) {
      return resource.data.createdBy == me() && incoming().id == groupId && incoming().createdBy == me()
        && incoming().members == [] && incoming().get('pendingMembers', []) == [] && incoming().get('admins', []) == []
        && incoming().get('deletedAt', null) is string;
    }
    function groupInvariants(groupId) { return incoming().id == groupId && incoming().createdBy == resource.data.createdBy && isValidChatGroup(incoming()); }
    function mapOk(k) {
      return !(k in incoming())
        || (k in resource.data
            ? incoming()[k].diff(resource.data[k]).affectedKeys().hasOnly([me().lower()])
            : incoming()[k].keys().hasOnly([me().lower()]));
    }
    function mapsOnlyMine() { return mapOk('memberJoinedAt') && mapOk('memberCanSeePastHistory'); }
    // Nobody can add another person to members directly (consent goes through pendingMembers and the invitee's own accept).
    function membersChangeOk() {
      let oldM = resource.data.members.toSet();
      let newM = incoming().members.toSet();
      return newM.difference(oldM).hasOnly([me()]) && (!(me() in newM.difference(oldM)) || isGroupInvitee(resource.data));
    }
    function selfServiceGroupChange() {
      let oldM = resource.data.members.toSet();
      let newM = incoming().members.toSet();
      let oldP = resource.data.get('pendingMembers', []).toSet();
      let newP = incoming().get('pendingMembers', []).toSet();
      let oldMute = resource.data.get('mutedBy', []).toSet();
      let newMute = incoming().get('mutedBy', []).toSet();
      return incoming().diff(resource.data).affectedKeys().hasOnly(['members', 'pendingMembers', 'mutedBy', 'memberJoinedAt', 'memberCanSeePastHistory'])
        && membersChangeOk() && oldM.difference(newM).hasOnly([me()])
        && oldP.difference(newP).hasOnly([me()])
        && (newP.difference(oldP).size() == 0
            || (isGroupMember(resource.data) && resource.data.get('onlyAdminsCanAddMembers', false) != true))
        && newMute.difference(oldMute).hasOnly([me()]) && oldMute.difference(newMute).hasOnly([me()])
        && mapsOnlyMine();
    }
    // Joining by invite code: the writer must present a code (joinedVia) that maps to THIS group in groupInvites AND equals the group's current
    // inviteCode, with invite links enabled. They can add only themselves and only their own join-time entries. Existing members/pending are untouched.
    function joinViaInvite(groupId) {
      let code = incoming().get('joinedVia', '');
      return code is string && code.matches('GRP-[A-F0-9]{20}')
        && exists(/databases/$(database)/documents/groupInvites/$(code))
        && get(/databases/$(database)/documents/groupInvites/$(code)).data.groupId == groupId
        && resource.data.get('inviteCode', '') == code
        && resource.data.get('isInviteLinkEnabled', true) != false
        && incoming().diff(resource.data).affectedKeys().hasOnly(['members', 'memberJoinedAt', 'memberCanSeePastHistory', 'joinedVia'])
        && incoming().members.toSet().difference(resource.data.members.toSet()).hasOnly([me()])
        && resource.data.members.toSet().difference(incoming().members.toSet()).size() == 0
        && mapsOnlyMine();
    }

    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if canWrite() && code.matches('GRP-[A-F0-9]{20}') && incoming().keys().hasOnly(['groupId', 'historyVisible'])
        && incoming().groupId is string
        && isGroupAdmin(get(/databases/$(database)/documents/chatGroups/$(incoming().groupId)).data)
        && get(/databases/$(database)/documents/chatGroups/$(incoming().groupId)).data.get('inviteCode', '') == code;
      allow delete: if false;
    }

    match /chatGroups/{groupId} {
      allow read: if signedIn() && (isGroupMember(resource.data) || isGroupInvitee(resource.data));
      // Random unguessable ids only (a deleted group's id cannot be recreated by guessing); the creator starts alone, others join by consent.
      allow create: if canWrite() && groupId.matches('group_[a-f0-9]{24}') && incoming().id == groupId && incoming().createdBy == me()
        && incoming().members == [me()] && isValidChatGroup(incoming());
      allow update: if canWrite() && groupInvariants(groupId) && (
          ((isGroupMember(resource.data) || isGroupInvitee(resource.data))
            && (selfServiceGroupChange() || (isGroupAdmin(resource.data) && isGroupMember(resource.data) && membersChangeOk())))
          || joinViaInvite(groupId)
          || groupTombstone(groupId));
      // Only the creator deletes a group. App admins have no group powers (a delete would let them recreate and read history).
      // Groups are never hard-deleted: a removed group id stays taken (tombstone) so nobody can recreate a known id and read its history.
      allow delete: if false;
    }

    // Chat privacy model:
    //  - 1:1 messages (partner chat and cross-couple DMs) are readable ONLY by the sender and the receiver, matched on permanent account ids.
    //    The sender's couple is NOT a reader: the sender's partner cannot read a DM addressed to someone else.
    //  - Messages with conversationId 'global' are readable by every signed-in user (the global lounge).
    //  - Group messages are readable by group members.
    //  - A message with no receiver and no conversation is readable only by its sender (and admins).
    // In-app admins get NO special read access to 1:1 messages: they read global/group chat like anyone else and may
    // moderate (delete) non-1:1 messages only. Operator access (Firebase console, service-account keys) is outside the rules.
    function chatField(data, key) { return data.get(key, ''); }
    // Participation is decided on permanent ids only. A row without senderId/receiverId (legacy) is readable by NO ONE through the rules
    // until an operator-reviewed backfill (admin SDK) assigns ids; there is deliberately no username fallback.
    function isChatSender(data) { return pid() != '' && data.get('senderId', null) == pid(); }
    function isChatReceiver(data) { return pid() != '' && data.get('receiverId', null) == pid(); }
    function isChatParticipant(data) { return isChatSender(data) || isChatReceiver(data); }
    function validDirectRecipient(data) {
      return !isDirectChat(data) || (data.get('receiverId', '') is string && data.get('receiverId', '').matches('(u|adm|leg):[^ ]+'));
    }
    // Only these fields may change on someone else's message (receiver marking seen, reacting, pinning).
    function onlyReceiptFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenBy', 'seenByTime', 'reaction', 'pinned', 'pinnedAt', 'pinnedBy']);
    }
    // Exact, case-sensitive shapes (the proxy and Supabase policies use the same ones). Anything else is a private 1:1 message.
    function isGlobalMsg(data) { return chatField(data, 'receiver') == 'global' && chatField(data, 'conversationId') == 'global'; }
    function isGroupMsg(data) { return chatField(data, 'receiver').matches('group_.*') && chatField(data, 'conversationId').matches('group_.*'); }
    function isUnaddressed(data) { return chatField(data, 'receiver') == '' && chatField(data, 'conversationId') == ''; }
    // New messages must not mix shapes (a person as receiver with a global/group conversation, or the reverse). Reads of global/group stay
    // keyed on conversationId alone so those listeners remain provable per query; mixed rows can therefore only come from legacy data.
    function validRouting(data) {
      return (chatField(data, 'conversationId') != 'global' || chatField(data, 'receiver') == 'global')
        && (chatField(data, 'receiver') != 'global' || chatField(data, 'conversationId') == 'global')
        && (!chatField(data, 'conversationId').matches('group_.*') || chatField(data, 'receiver') == chatField(data, 'conversationId'))
        && (!chatField(data, 'receiver').matches('group_.*') || chatField(data, 'receiver') == chatField(data, 'conversationId'));
    }
    function isDirectChat(data) { return !isGlobalMsg(data) && !isGroupMsg(data) && !isUnaddressed(data); }
    function chatRoutingUnchanged() {
      return incoming().get('receiver', null) == resource.data.get('receiver', null)
        && incoming().get('conversationId', null) == resource.data.get('conversationId', null)
        && incoming().get('senderId', null) == resource.data.get('senderId', null)
        && incoming().get('receiverId', null) == resource.data.get('receiverId', null)
        && incoming().get('authorId', null) == resource.data.get('authorId', null)
        && incoming().sender == resource.data.sender;
    }

    function groupOf(data) { return get(/databases/$(database)/documents/chatGroups/$(chatField(data, 'conversationId'))).data; }
    // Non-direct (global/group) access: global needs the open lounge claim; a group needs current membership.
    function nonDirectReadable(data) {
      return (chatField(data, 'conversationId') == 'global' && globalOpen())
        || (chatField(data, 'conversationId').matches('group_.*') && me() in groupOf(data).members);
    }
    // Posting to a group needs membership, and in announcement mode a group admin.
    function canPostToGroup(data) {
      return !chatField(data, 'conversationId').matches('group_.*')
        || (me() in groupOf(data).members && (groupOf(data).get('onlyAdminsCanSend', false) != true || isGroupAdmin(groupOf(data))));
    }
    // Global/group rows carry authorId (never senderId/receiverId), so the participant queries for 1:1 chat can never return them.
    function isAuthor(data) { return pid() != '' && data.get('authorId', null) == pid(); }
    function noPersonIds(data) { return !('senderId' in data) && !('receiverId' in data); }

    match /chatMessages/{messageId} {
      allow read: if signedIn() && (isChatParticipant(resource.data) || nonDirectReadable(resource.data));
      allow create: if canWrite() && isValidId(messageId) && incoming().id == messageId && isValidChatMessage(incoming())
        && incoming().sender == me() && pid() != '' && validRouting(incoming())
        && (isAdmin() || sameCouple(incoming()))
        && (isDirectChat(incoming())
            ? (incoming().get('senderId', null) == pid() && validDirectRecipient(incoming()) && !('authorId' in incoming()))
            : (incoming().get('authorId', null) == pid() && noPersonIds(incoming()) && nonDirectReadable(incoming()) && canPostToGroup(incoming())));
      // Authors edit their own message but never re-route it. The 1:1 receiver, and members of an open group/global room, may only change receipt fields.
      allow update: if canWrite() && isValidId(messageId) && incoming().id == messageId && isValidChatMessage(incoming())
        && chatRoutingUnchanged()
        && (isChatSender(resource.data)
            || (isAuthor(resource.data) && nonDirectReadable(resource.data))
            || (isChatReceiver(resource.data) && onlyReceiptFields())
            || (!isDirectChat(resource.data) && nonDirectReadable(resource.data) && onlyReceiptFields()));
      // Authors delete their own messages. Admins may moderate (delete) global/group messages, never 1:1 messages.
      allow delete: if canWrite() && (isChatSender(resource.data) || (isAuthor(resource.data) && nonDirectReadable(resource.data)) || (isAdmin() && !isDirectChat(resource.data)));
    }

    match /milestones/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidMilestone(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidMilestone(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    match /datePlans/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidDatePlan(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidDatePlan(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    match /memories/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidMemory(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidMemory(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    match /letters/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidLoveLetter(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidLoveLetter(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    match /coupleQuestions/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidCoupleQuestion(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidCoupleQuestion(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    match /celebrationCards/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidCelebrationCard(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidCelebrationCard(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    // Music sharing (per track, owner's choice). A grant doc is created by the track's owner for the partner's pid. The partner may read that one track only while BOTH
    // members docs are active in the same current joint space (server-written). Unlink makes the grant dormant, a relink of the same pair makes it effective again. Read-only for the partner.
    function grantPath(trackId) { return /databases/$(database)/documents/musicGrants/$(trackId); }
    function memberOf(p) { return /databases/$(database)/documents/members/$(p); }
    function grantLinked(g) {
      return g.ownerPid is string && g.granteePid is string && g.ownerPid != g.granteePid
        && exists(memberOf(g.ownerPid)) && exists(memberOf(g.granteePid))
        && get(memberOf(g.ownerPid)).data.state == 'active' && get(memberOf(g.granteePid)).data.state == 'active'
        && get(memberOf(g.ownerPid)).data.coupleId is string && get(memberOf(g.ownerPid)).data.coupleId.size() > 0
        && get(memberOf(g.ownerPid)).data.coupleId == get(memberOf(g.granteePid)).data.coupleId;
    }
    function musicShared(data) {
      return signedIn() && pid() != '' && data.get('id', '') is string && data.get('id', '') != '' && exists(grantPath(data.id))
        && get(grantPath(data.id)).data.granteePid == pid()
        && get(grantPath(data.id)).data.ownerSpace == data.get('coupleId', null)
        && grantLinked(get(grantPath(data.id)).data);
    }
    match /musicGrants/{trackId} {
      allow read: if signedIn() && (resource.data.granteePid == pid() || resource.data.ownerPid == pid());
      allow create: if canWrite() && personalId() != '' && isValidId(trackId)
        && incoming().keys().hasOnly(['trackId', 'ownerPid', 'granteePid', 'ownerSpace', 'createdAt'])
        && incoming().keys().hasAll(['trackId', 'ownerPid', 'granteePid', 'ownerSpace'])
        && incoming().trackId == trackId && incoming().ownerPid == pid() && incoming().ownerSpace == personalId()
        && incoming().granteePid is string && incoming().granteePid != pid() && incoming().granteePid.size() <= 128
        && exists(/databases/$(database)/documents/musicTracks/$(trackId))
        && get(/databases/$(database)/documents/musicTracks/$(trackId)).data.coupleId == personalId()
        && exists(memberOf(incoming().granteePid)) && get(memberOf(incoming().granteePid)).data.coupleId == get(memberPath()).data.coupleId;
      allow update: if false;
      allow delete: if canWrite() && resource.data.ownerPid == pid();
    }

    match /musicTracks/{docId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data) || musicShared(resource.data);
      allow create: if isAdmin() || (canWrite() && isValidId(docId) && incoming().id == docId && ownPersonal(incoming()) && isValidMusicTrack(incoming()));
      allow update: if isAdmin() || (canWrite() && ownPersonal(resource.data) && ownPersonal(incoming()) && incoming().id == docId && isValidMusicTrack(incoming()));
      allow delete: if isAdmin() || (canWrite() && ownPersonal(resource.data));
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin() || ownPersonal(resource.data) || jointRead(resource.data);
      allow create: if signedIn() && isValidId(logId) && incoming().id == logId && ownPersonal(incoming()) && isValidActivityLog(incoming());
      allow update: if false; // audit logs are immutable
      allow delete: if isAdmin();
    }

    // User accounts: Prevents account takeover, username hijacking, and impersonation of admin
    // Locked: accounts (password hashes, 2FA secrets) are served only by the authenticated server API.
    match /userAccounts/{docId} {
      allow read, write: if false;
    }

    // Admin settings: Protected against unauthorized client deletion and ID poisoning
    // Locked: admin credentials and settings are served only by the authenticated server API.
    match /adminSettings/{docId} {
      allow read, write: if false;
    }

    // Couple tenants: Protected against workspace destruction
    // Locked: tenant records are served only by the authenticated server API.
    match /coupleTenants/{docId} {
      allow read, write: if false;
    }

    // Startup connection ping document (read-only)
    match /_connection_test_metadata_/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
